# Copy this file to backend/.env if you need to override defaults.
# The backend holds NO LLM config — the API key and model live in agent/.env.

# Where the agent (LLM/RAG engine) is running.
AGENT_BASE_URL=http://localhost:8001

# How long to wait on the agent before giving up (seconds).
AGENT_TIMEOUT=120

# Where the frontend runs (for CORS). Comma-separate for multiple origins.
FRONTEND_ORIGIN=http://localhost:3000

# Largest file this service will accept, in bytes. 25 MB.
# The outermost boundary, and the one that matters most — this is where an
# oversized upload would otherwise be buffered in memory before forwarding.
MAX_UPLOAD_BYTES=26214400

# ── Database (stage 1.2) ─────────────────────────────────────────────────────
# One DSN, not five variables — the shape every managed provider hands you.
#
# The default in app/core/config.py already points at the local Compose
# service, so this only needs setting to override it. Credentials for that
# container are throwaway and live in docker-compose.yml; nothing here is a
# secret, and nothing here should be reused anywhere real.
#
# A DSN pasted from a managed provider will start `postgresql://` — the config
# upgrades that to the asyncpg driver automatically.
# DATABASE_URL=postgresql+asyncpg://myrag:myrag_dev_password@localhost:5432/myrag

# Print every SQL statement the ORM generates. Noisy, and on in development on
# purpose: reading what SQLAlchemy actually emits, BEGIN and COMMIT included,
# is most of what stage 1.2 is for.
DB_ECHO=true

# Connection pool. These match SQLAlchemy's defaults and are written out so
# the arithmetic is visible:
#   workers x (POOL_SIZE + MAX_OVERFLOW) <= Postgres max_connections (100)
# Stage 8.3 replaces these guesses with measured numbers.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10


# ── OpenRouter ────────────────────────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model to answer with. Browse https://openrouter.ai/models and filter to free
# tier — the free lineup changes, so verify the id is still listed before using.
# Free ids end in ":free". Examples seen on the free tier:
#   deepseek/deepseek-chat-v3-0324:free
#   meta-llama/llama-3.3-70b-instruct:free
#   google/gemma-3-27b-it:free
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# OpenRouter's API endpoint. Only change this to switch providers entirely.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional attribution headers. OpenRouter uses these to rank apps on their
# leaderboards; both may be left blank.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=myRAG

# ── Generation ────────────────────────────────────────────────────────────────
# Max tokens the model may generate per reply.
CHAT_MAX_TOKENS=4096

# Lower = more factual and repeatable. Raise toward 1.0 for more variety.
CHAT_TEMPERATURE=0.3

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8001
# ── Embeddings (Google Gemini) ────────────────────────────────────────────────
# OpenRouter does not provide embedding models, so this is a second provider.
# Free key, no billing needed: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Changing either of these invalidates every stored vector and forces a full
# re-ingest of every document. See docs/decisions/0002-embedding-provider.md
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# ── Vector store ──────────────────────────────────────────────────────────────
# Local folder: Qdrant runs embedded, no Docker required.
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=documents
# Set this to use a real Qdrant server instead of local files:
# QDRANT_URL=http://localhost:6333

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=1200
CHUNK_OVERLAP=180

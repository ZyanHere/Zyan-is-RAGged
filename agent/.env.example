
# ── OpenRouter ────────────────────────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model to answer with. Browse https://openrouter.ai/models and filter to free
# tier — the free lineup changes, so verify the id is still listed before using.
# Free ids end in ":free". Examples seen on the free tier:
#   deepseek/deepseek-chat-v3-0324:free
#   meta-llama/llama-3.3-70b-instruct:free
#   google/gemma-3-27b-it:free
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# OpenRouter's API endpoint. Only change this to switch providers entirely.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional attribution headers. OpenRouter uses these to rank apps on their
# leaderboards; both may be left blank.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=myRAG

# ── Generation ────────────────────────────────────────────────────────────────
# Max tokens the model may generate per reply.
CHAT_MAX_TOKENS=4096

# Lower = more factual and repeatable. Raise toward 1.0 for more variety.
CHAT_TEMPERATURE=0.3

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8001
# ── Embeddings (Google Gemini) ────────────────────────────────────────────────
# OpenRouter does not provide embedding models, so this is a second provider.
# Free key, no billing needed: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Changing either of these invalidates every stored vector and forces a full
# re-ingest of every document. See docs/decisions/0002-embedding-provider.md
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# ── The fake embedding provider (stage 2.5) ──────────────────────────────────
#
# "fake" replaces the embedder with a hash of the text. It needs no API key and
# costs no quota, which is what makes a load test possible at all — a real
# ingest against the free tier is rate-limited to a 429 within about a second,
# so every result would be a quota artefact rather than an observation about
# concurrency.
#
# **It produces meaningless vectors.** Retrieval against them is nonsense by
# design. Three guards keep that contained:
#
#   1. it is never the default, and an unrecognised value is refused outright
#      rather than falling back to either provider
#   2. it refuses to start if QDRANT_COLLECTION is the default "documents"
#   3. every chunk it writes carries embedding_model="fake-embedding", so if
#      the first two ever fail, the damage is findable rather than invisible
#
# EMBEDDING_PROVIDER=fake
# QDRANT_COLLECTION=loadtest
#
# Milliseconds slept per batch of 100 chunks — *per batch*, because the real
# provider costs one network round trip per batch rather than per chunk.
# Calibrate it against a real call rather than guessing; an arbitrary number
# makes every latency figure a fact about that number. Zero (the default)
# makes this a fast deterministic embedder, which is useful in ordinary tests.
#
# FAKE_EMBED_DELAY_MS=0

# ── Vector store ──────────────────────────────────────────────────────────────
# Local folder: Qdrant runs embedded, no Docker required.
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=documents
# Set this to use a real Qdrant server instead of local files:
# QDRANT_URL=http://localhost:6333

# ── Retrieval ─────────────────────────────────────────────────────────────────
# How many chunks retrieval returns per question. Read by the rag engine, which
# owns this default — the agent holds no opinion of its own about it.
TOP_K=5

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=1200
CHUNK_OVERLAP=180

# ── Uploads ───────────────────────────────────────────────────────────────────
# Largest file this service will accept, in bytes. 25 MB.
# Enforced here as well as at the backend: two independent trust boundaries,
# and neither may assume the other did its job.
MAX_UPLOAD_BYTES=26214400
